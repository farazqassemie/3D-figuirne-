# Copy to .env and fill in what you have. Missing keys fall back to mock providers,
# so the full customer journey is clickable without spending anything.

# fal.ai key — powers the AI preview (Rodin). https://fal.ai/dashboard/keys
FAL_KEY=

# KIRI Engine API key — CURRENTLY UNUSED (the video/photogrammetry path is unwired;
# the app is photos -> AI mesh only). Kept for if you re-wire lib/providers/recon.js.
KIRI_KEY=

# Hi3D (hitem3d.ai) — the alternative AI preview engine, offered to customers
# alongside Rodin. Handles both figurines AND portraits (Rodin is figurine-only).
# Two-step auth: a client_id + client_secret are exchanged for a token, so BOTH
# are required. Get them at https://platform.hi3d.ai/console/apiKey
# When both are set, Hi3D appears as a customer choice on the upload screens.
HI3D_CLIENT_ID=
HI3D_CLIENT_SECRET=
# Force-hide Hi3D from customers even when credentials are set (e.g. before you
# have run one real verification generation):
# HI3D_ENABLED=0
#
# Hi3D is LOCKED to MAXIMUM quality in code (audited as Hi3D's true top tier —
# nothing higher exists): 1536pro resolution · 2,000,000 polygons · PBR on ·
# geometry+texture · GLB · multi-view. Those are NOT env-tunable, so a fast /
# low-quality setting can never slip in. Only these are adjustable:
#   HI3D_VERSION=v2.1        model version — v2.1 is the newest/best (only bump if Hi3D ships a higher one)
#   HI3D_MULTIVIEW=1         use multi-view for figurines; set 0 ONLY if the API ever rejects multi_images
#   HI3D_MAX_WAIT_MS=3600000 how long to poll before giving up (default 60 min)
# PORTRAIT tuning (photoreal faces):
#   Portraits default to a SINGLE FRONT photo — multi-view fusion AVERAGES hand-held
#   shots and SMOOTHS facial detail (per Hi3D's own research). Set the following only to experiment:
#   HI3D_PORTRAIT_MULTIVIEW=1   force portraits back to 4-view (only worth it for rigid tripod/turntable capture)
#   HI3D_PORTRAIT_MODEL=...     override the portrait model (default scene-portraitv2.1 — the detail winner; do not use the general model)

# Force providers regardless of keys: fal-rodin | hi3d | mock  /  kiri | mock
# PREVIEW_PROVIDER=mock
# RECON_PROVIDER=mock

# Admin token — gates the internal dashboard surfaces (/api/jobs, /api/hi3d/balance).
# Without it those endpoints return 401. Open the dashboard at /admin.html?token=<value>.
ADMIN_TOKEN=

PORT=3000
